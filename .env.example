# Database (docker compose exposes Postgres on port 5433)
DATABASE_URL="postgresql://coolkick:coolkick@localhost:5433/coolkick?schema=public"

# Auth.js – generate with: npx auth secret  (or any 32+ char random string)
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# Public site settings
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_SHOP_PHONE="+919876543210"

# First owner account created by `npm run db:seed`
SEED_ADMIN_EMAIL="owner@coolkick.in"
SEED_ADMIN_PASSWORD="change-me-please"

# Image storage: "local" (writes to ./uploads – dev and VPS) or "cloudinary" (needed on Vercel)
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
